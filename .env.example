# ============================================================
# sre.ai — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# ── Anthropic (required) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── API Security ────────────────────────────────────────────
# Set a strong random string. Leave empty to disable auth (dev only).
API_KEY=

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sreai:localdev@localhost:5432/sreai

# ── Redis / Celery ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Slack ───────────────────────────────────────────────────
# Create app at https://api.slack.com/apps → OAuth & Permissions → chat:write scope
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#incidents

# ── GitHub ──────────────────────────────────────────────────
# Create at https://github.com/settings/tokens → repo scope
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo

# ── PagerDuty ───────────────────────────────────────────────
# Webhook secret from PagerDuty → Integrations → Generic Webhooks (v3)
PAGERDUTY_WEBHOOK_SECRET=

# ── Datadog ─────────────────────────────────────────────────
# https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# ── Grafana ─────────────────────────────────────────────────
GRAFANA_URL=https://your-grafana.example.com
GRAFANA_API_KEY=
GRAFANA_WEBHOOK_SECRET=

# ── Topology ────────────────────────────────────────────────
# JSON array of [source, target] pairs for static service edges
# Example: [["api-gateway","auth-service"],["api-gateway","order-service"]]
TOPOLOGY_EDGES=[]

# ── Frontend (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=

# ── App ─────────────────────────────────────────────────────
DEBUG=false
MAX_INVESTIGATION_TURNS=20
